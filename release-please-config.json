{
  "release-type": "simple",
  "include-component-in-tag": false,
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "cardinal",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'cardinal' || @.name.value == 'cardinal-test-support')].version"
        }
      ]
    }
  }
}
