#!/bin/sh
# The completion check of every change (docs/architecture.md section 13.4): formatting,
# clippy, and the tests, run confined between a snapshot and a verify of the repository
# guard. Run it as `mise exec -- scripts/test` (on Windows, `mise exec -- sh scripts/test`).
#
#   scripts/test                 the check
#   scripts/test --self-check    show that each isolation mechanism holds: run the canaries
#                                of crates/test-support/canaries and expect each escape to
#                                fail or be caught
#
# Phase 1 (fmt, clippy, `cargo nextest archive`) builds without confinement. Phase 2 runs the
# archived tests with cargo-nextest in a constructed environment under a per-run root R
# (HOME, XDG dirs, temp dir, and git's global config inside R), each test process confined
# so that it can write only inside R: sandbox-exec on macOS, bubblewrap on Linux where it
# works; Windows gets the environment and the guard only. Afterwards every process the run
# left behind is listed, killed, and fails the run. A run's processes are those in its
# sandbox on macOS (found with sandbox-pids from crates/test-support) and those carrying a
# marker unique to the run, CARDINAL_TEST_RUN=<id>, in /proc on Linux.

# POSIX prelude: start over in a constructed environment before bash reads any startup file.
# A script run by `sh` reads no startup file, and `bash --noprofile --norc` with BASH_ENV and
# ENV unset reads none either. What passes, and why:
#   PATH                       the pinned toolchain that `mise exec` put first
#   CARGO_HOME, RUSTUP_HOME    where that toolchain and the registry live (defaulting to the
#   RUSTUP_TOOLCHAIN           locations under HOME), and which toolchain mise pinned
#   CI                         selects the guard's whole-repository mode
#   CARGO_TERM_COLOR           output only
#   Windows: what programs need to start (scripts/clean-env.sh), and TEMP, TMP, USERPROFILE,
#   APPDATA, LOCALAPPDATA, ProgramData, ProgramFiles, ProgramFiles(x86), ProgramW6432 for
#   the MSVC linker lookup.
# Nothing else passes: not HOME, BASH_ENV, ENV, GIT_*, GH_*, CLAUDE_*, or CARDINAL_*.
if [ "${1-}" != --clean-env ]; then
  CARGO_HOME=${CARGO_HOME:-${HOME:-}/.cargo}
  RUSTUP_HOME=${RUSTUP_HOME:-${HOME:-}/.rustup}
  export CARGO_HOME RUSTUP_HOME
  . "$(dirname "$0")/clean-env.sh"
  linker_vars=
  case $(uname -s) in
    MINGW* | MSYS* | CYGWIN*)
      linker_vars='TEMP TMP USERPROFILE APPDATA LOCALAPPDATA ProgramData ProgramFiles ProgramFiles(x86) ProgramW6432'
      ;;
  esac
  clean_exec "PATH CARGO_HOME RUSTUP_HOME RUSTUP_TOOLCHAIN CI CARGO_TERM_COLOR $linker_vars" \
    bash --noprofile --norc "$0" --clean-env "$@"
fi
shift

set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true
export LC_ALL=C
# Passed only when set; an empty one would name no toolchain.
[ -n "${RUSTUP_TOOLCHAIN-}" ] || unset RUSTUP_TOOLCHAIN
[ -n "${CARGO_TERM_COLOR-}" ] || unset CARGO_TERM_COLOR

root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"
. scripts/clean-env.sh
os=$(uname -s)
case $os in MINGW* | MSYS* | CYGWIN*) os=Windows ;; esac

say() {
  printf 'scripts/test: %s\n' "$*" >&2
}

# The per-run root, outside any repository: `mktemp -d` in the system temp dir (TMPDIR did
# not pass). Removed on every exit, after the sweep.
R=$(cd "$(mktemp -d)" && pwd -P)
dir=$R
while [ "$dir" != / ] && [ -n "$dir" ]; do
  if [ -e "$dir/.git" ]; then
    say "the per-run root $R is inside the repository $dir"
    exit 1
  fi
  dir=$(dirname "$dir")
done
mkdir -p "$R/home/.config" "$R/home/.cache" "$R/home/.local/state" "$R/home/.local/share" \
  "$R/tmp" "$R/archive"
: >"$R/empty-gitconfig"
run_id=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
marker="CARDINAL_TEST_RUN=$run_id"
# macOS: the sandbox profile denies looking up this Mach service, which nobody registers, and
# allows `<name>.allowed`; only this run's sandbox does both.
sandbox_name=dev.cardinal.test-run.$run_id

# Background processes the self-check starts outside the tests, killed on every exit.
helpers=()
cleanup() {
  local status=$?
  local pid
  for pid in ${helpers[@]+"${helpers[@]}"}; do
    kill "$pid" 2>/dev/null || true
  done
  if ! sweep; then
    status=1
  fi
  rm -rf "$R" "$R.sock"
  exit "$status"
}
trap cleanup EXIT

# Phase 1 runs with HOME inside R too, so nothing it starts reads the user's dotfiles.
export HOME=$R/home XDG_CONFIG_HOME=$R/home/.config XDG_CACHE_HOME=$R/home/.cache \
  XDG_STATE_HOME=$R/home/.local/state XDG_DATA_HOME=$R/home/.local/share \
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=$R/empty-gitconfig GIT_TERMINAL_PROMPT=0

# --- Supervisor: this run's processes ----------------------------------------------------

# Where scan reads the process table; the self-check points them elsewhere to show that a
# table it cannot read fails the sweep.
sandbox_pids=
proc_root=/proc

# Builds sandbox-pids on macOS.
build_scanner() {
  [ "$os" = Darwin ] || return 0
  sandbox_pids=$(cargo build --locked -p cardinal-test-support --bin sandbox-pids \
    --message-format=json-render-diagnostics |
    sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -n 1)
  if [ ! -x "$sandbox_pids" ]; then
    say "cannot build sandbox-pids"
    exit 1
  fi
}

# Prints the PIDs of this user's processes that belong to the run, and `?<pid>` for each
# process whose membership cannot be read (Linux: a process that is not dumpable hides its
# environment even from its owner); fails when the process table cannot be read. On macOS the
# environment is no help: macOS hides that of platform binaries such as /bin/sleep even from
# their owner.
scan() {
  case $os in
    Darwin)
      [ -n "$sandbox_pids" ] || return 1
      "$sandbox_pids" "$sandbox_name.denied" "$sandbox_name.allowed" || return 1
      ;;
    Linux)
      [ -r "$proc_root/self/environ" ] || return 1
      local proc environ
      for proc in "$proc_root"/[0-9]*; do
        [ -O "$proc" ] || continue
        # A process that exits meanwhile has no environment left to read.
        if ! environ=$({ tr '\0' '\n' <"$proc/environ"; } 2>/dev/null); then
          [ ! -e "$proc" ] || echo "?${proc##*/}"
          continue
        fi
        if printf '%s\n' "$environ" | grep -qxF "$marker"; then
          echo "${proc##*/}"
        fi
      done
      ;;
    *)
      return 2
      ;;
  esac
}

# The PIDs that belong to the run.
marked_pids() {
  local found
  found=$(scan) || return
  printf '%s\n' "$found" | grep -v '^?' || true
}

# Kills and lists every process this run left behind; fails if there was one, if the
# process table cannot be read, or if a process whose membership cannot be read appeared
# since check_sweep (it may be a test process). Each PID found is in this run's sandbox or
# carries its marker, so it is one this run started. Nothing to do before the first test
# process starts.
started=0
swept=0
sweep() {
  [ "$started" -eq 1 ] || return 0
  local found pids hidden status=0 failed=0
  found=$(scan) || status=$?
  if [ "$status" -eq 2 ]; then
    return 0
  elif [ "$status" -ne 0 ]; then
    say "cannot read the process table to find leftover test processes"
    return 1
  fi
  pids=$(printf '%s\n' "$found" | grep -v '^?' || true)
  hidden=$(printf '%s\n' "$found" | sed -n 's/^?//p' | sort)
  for pid in $(printf '%s\n' "$hidden" | comm -13 "$R/hidden" - 2>/dev/null); do
    say "cannot tell whether process $(ps -o pid= -o command= -p "$pid" 2>/dev/null || echo "$pid") belongs to the run; it started during the run"
    failed=1
  done
  [ -n "$pids" ] || return "$failed"
  for pid in $pids; do
    say "leftover test process: $(ps -o pid= -o pgid= -o command= -p "$pid" 2>/dev/null || echo "$pid")"
    kill -KILL "$pid" 2>/dev/null || true
    swept=$((swept + 1))
  done
  sleep 0.2
  if [ -n "$(marked_pids)" ]; then
    say "leftover test processes survived SIGKILL: $(marked_pids | tr '\n' ' ')"
  fi
  return 1
}

# Starts a process the way a test process starts, confined and with the marker, and checks
# that the sweep sees it, so a sweep that finds nothing means nothing was left.
check_sweep() {
  started=1
  [ "$os" != Windows ] || {
    say "Windows: no process sweep; leftovers are found only by nextest's leak check"
    return 0
  }
  local found
  if ! found=$(scan); then
    say "cannot read the process table"
    return 1
  fi
  # Processes whose membership is already hidden are not this run's.
  printf '%s\n' "$found" | sed -n 's/^?//p' | sort >"$R/hidden"
  # shellcheck disable=SC2086 # the runner is a command line without spaces
  env -i PATH="$PATH" "$marker" $runner sleep 30 &
  local probe=$! pids tries=0
  # The fork shows the marker or the sandbox only once env has run.
  while :; do
    pids=$(marked_pids) || {
      kill "$probe"
      say "cannot read the process table"
      return 1
    }
    case " $(printf '%s ' $pids)" in *" $probe "*) break ;; esac
    tries=$((tries + 1))
    [ "$tries" -lt 50 ] || break
    sleep 0.1
  done
  kill "$probe"
  wait "$probe" 2>/dev/null || true
  case " $(printf '%s ' $pids)" in
    *" $probe "*) ;;
    *)
      say "the process sweep cannot see process $probe"
      return 1
      ;;
  esac
}

# --- Confinement -------------------------------------------------------------------------

# Sets `runner` to the command that confines one test process, or empty, and `confinement`
# to a description.
runner=
confinement=
setup_confinement() {
  case $R in *' '*)
    # A target runner is split at spaces.
    if [ "$os" = Darwin ]; then
      say "cannot confine the tests: the per-run root $R has a space"
      exit 1
    fi
    confinement="UNCONFINED: the per-run root $R has a space, which a target runner cannot carry"
    say "$confinement"
    return
    ;;
  esac
  case $os in
    Darwin)
      cat >"$R/sandbox.sb" <<EOF
(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath "$R")
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (regex #"^/dev/fd/[0-9]+\$")
  (regex #"^/dev/ttys[0-9]+\$"))
(deny network*)
(allow network* (local unix-socket (subpath "$R")))
(allow network* (remote unix-socket (subpath "$R")))
(deny mach-lookup (global-name "$sandbox_name.denied"))
EOF
      runner="sandbox-exec -f $R/sandbox.sb"
      confinement="sandbox-exec: writes only under the per-run root, no network"
      ;;
    Linux)
      # A fresh /dev: on the read-only bind of the host's, /dev/null cannot be opened for
      # writing, which every child with null stdio needs. Empty file systems over the places
      # that hold the host's Unix sockets (agents, the session bus, container daemons) and
      # shared memory, so a test cannot reach them; then R, which lies under /tmp.
      local bwrap=(bwrap --ro-bind / / --dev /dev) mask
      for mask in /tmp /var/tmp /run /var/run /dev/shm; do
        if [ "$mask" = /dev/shm ] || { [ -d "$mask" ] && [ ! -L "$mask" ]; }; then
          bwrap+=(--tmpfs "$mask")
        fi
      done
      bwrap+=(--bind "$R" "$R" --unshare-net --die-with-parent --)
      local error
      if error=$("${bwrap[@]}" sh -c ': >/dev/null && : >"$1/probe"' sh "$R" 2>&1); then
        runner="${bwrap[*]}"
        confinement="bubblewrap: writes only under the per-run root, no network, host sockets masked"
      else
        confinement="UNCONFINED: bubblewrap does not work here (${error:-not installed}); writes outside the per-run root are found only by the repository guard"
      fi
      ;;
    *)
      confinement="UNCONFINED on $os: constructed environment and the repository guard only"
      ;;
  esac
  say "$confinement"
}

# --- Phase 2 -----------------------------------------------------------------------------

host=$(rustc -vV | sed -n 's/^host: //p')
runner_var=CARGO_TARGET_$(printf '%s' "$host" | tr 'a-z-' 'A-Z_')_RUNNER

# run_archive <archive> <workspace> [nextest args...]: the archived tests in the constructed
# environment, each test process confined. Returns nextest's status.
run_archive() {
  local archive=$1 workspace=$2
  shift 2
  started=1
  local extract
  extract=$(mktemp -d "$R/archive/XXXXXX")
  local env=(
    PATH="$PATH"
    HOME="$R/home"
    XDG_CONFIG_HOME="$R/home/.config"
    XDG_CACHE_HOME="$R/home/.cache"
    XDG_STATE_HOME="$R/home/.local/state"
    XDG_DATA_HOME="$R/home/.local/share"
    GIT_CONFIG_NOSYSTEM=1
    GIT_CONFIG_GLOBAL="$R/empty-gitconfig"
    GIT_CEILING_DIRECTORIES="$(dirname "$R")"
    GIT_TERMINAL_PROMPT=0
    LC_ALL=C
    PROPTEST_DISABLE_FAILURE_PERSISTENCE=1
    "$marker"
  )
  if [ "$os" = Windows ]; then
    env+=(TEMP="$R/tmp" TMP="$R/tmp" USERPROFILE="$R/home" APPDATA="$R/home/AppData/Roaming"
      LOCALAPPDATA="$R/home/AppData/Local")
    local name value
    for name in $windows_start_vars; do
      if value=$(printenv "$name"); then
        env+=("$name=$value")
      fi
    done
  else
    env+=(TMPDIR="$R/tmp")
  fi
  [ -z "${CARGO_TERM_COLOR-}" ] || env+=(CARGO_TERM_COLOR="$CARGO_TERM_COLOR")
  [ -z "$runner" ] || env+=("$runner_var=$runner")
  env -i "${env[@]}" cargo-nextest nextest run --archive-file "$archive" \
    --workspace-remap "$workspace" --extract-to "$extract" \
    --config-file "$root/.config/nextest.toml" "$@"
}

# --- Self-check ----------------------------------------------------------------------------

canaries=$root/crates/test-support/canaries
canary_target=$root/target/canaries

self_check() {
  local failed=0 out status
  check() {
    say "self-check: $1: $2"
    [ "$2" != FAILED ] || failed=1
  }
  CARGO_TARGET_DIR=$canary_target cargo nextest archive --locked \
    --manifest-path "$canaries/Cargo.toml" --archive-file "$R/canaries.tar.zst"

  # Each way to build a spawnable command outside the spawn API fails the lint.
  local example
  for example in raw_spawn cargo_ext_spawn; do
    if out=$(CARGO_TARGET_DIR=$canary_target cargo clippy --locked \
      --manifest-path "$canaries/Cargo.toml" --example "$example" -- -D warnings 2>&1); then
      check "$example fails the lint" FAILED
    elif printf '%s' "$out" | grep -q 'disallowed_methods\|disallowed method'; then
      check "$example fails the lint" ok
    else
      printf '%s\n' "$out" >&2
      check "$example fails the lint" FAILED
    fi
  done

  # A write outside R fails, and nothing is written.
  local escape=$root/target/canary-escape
  rm -f "$escape"
  status=0
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=writes_outside_root)' || status=$?
  if [ -n "$runner" ]; then
    if [ "$status" -ne 0 ] && [ ! -e "$escape" ]; then
      check "a write outside the per-run root fails" ok
    else
      check "a write outside the per-run root fails" FAILED
    fi
  else
    check "a write outside the per-run root fails" "not prevented on $os ($confinement)"
  fi
  rm -f "$escape"

  # A Unix socket outside R, at $R.sock where a listener started before the tests accepts
  # connections, cannot be reached; one inside R can. Without confinement the same test
  # reaches it, which shows the listener works.
  if [ "$os" != Windows ]; then
    socket_check
  else
    check "a Unix socket outside the per-run root is unreachable" "not checked on Windows"
  fi

  # Leftover processes are killed and fail the run: one with its output closed, one in a
  # session of its own, one that closed every descriptor, and a daemon (forked twice, in a
  # new session, every descriptor closed).
  if [ "$os" != Windows ]; then
    run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(~leaves_)' || true
    swept=0
    if sweep; then
      check "leftover processes are killed and fail the run" FAILED
    elif [ "$swept" -ge 4 ] && [ -z "$(marked_pids)" ]; then
      check "leftover processes are killed and fail the run" ok
    else
      check "leftover processes are killed and fail the run (swept $swept of 4)" FAILED
    fi
  else
    check "leftover processes are killed and fail the run" "not checked on Windows"
  fi

  # A process table that cannot be read fails the sweep instead of reading as empty.
  if [ "$os" != Windows ]; then
    if (sandbox_pids=false proc_root=$R/no-proc sweep) 2>"$R/sweep.err"; then
      check "an unreadable process table fails the run" FAILED
    elif grep -q 'cannot read the process table' "$R/sweep.err"; then
      check "an unreadable process table fails the run" ok
    else
      cat "$R/sweep.err" >&2
      check "an unreadable process table fails the run" FAILED
    fi
  else
    check "an unreadable process table fails the run" "not checked on Windows"
  fi

  # Started with BASH_ENV, ENV, and GIT_* pointing at a decoy, no test sees them, no startup
  # file runs, the guard inspects this checkout, and the decoy is untouched.
  local decoy=$R/decoy
  git init -q -b main "$decoy"
  git -C "$decoy" -c user.name=decoy -c user.email=decoy@invalid commit -q --allow-empty -m decoy
  scripts/repo-guard snapshot "$decoy" "$R/decoy.snapshot"
  printf 'echo ran >%s\n' "$R/startup-ran" >"$R/startup"
  status=0
  out=$(BASH_ENV=$R/startup ENV=$R/startup GIT_DIR=$decoy/.git GIT_WORK_TREE=$decoy \
    GIT_INDEX_FILE=$decoy/.git/index sh "$root/scripts/test" --env-probe "$R/canaries.tar.zst" \
    2>&1) || status=$?
  printf '%s\n' "$out" | sed 's/^/  /' >&2
  if [ "$status" -eq 0 ] && [ ! -e "$R/startup-ran" ] &&
    printf '%s\n' "$out" | grep -qxF "top $root" &&
    scripts/repo-guard verify "$decoy" "$R/decoy.snapshot"; then
    check "inherited BASH_ENV, ENV, and GIT_* reach nothing" ok
  else
    check "inherited BASH_ENV, ENV, and GIT_* reach nothing" FAILED
  fi
  return "$failed"
}

# The socket part of the self-check: a listener (the canaries' `listen` example, which exits
# by itself after two minutes and is killed on every exit of this script) at $R.sock.
socket_check() {
  local name="a Unix socket outside the per-run root is unreachable"
  CARGO_TARGET_DIR=$canary_target cargo build --locked --quiet \
    --manifest-path "$canaries/Cargo.toml" --example listen
  "$canary_target/debug/examples/listen" "$R.sock" 120 &
  local listener=$! tries=0 inside=0 outside=0 control=0
  helpers+=("$listener")
  while [ ! -S "$R.sock" ]; do
    tries=$((tries + 1))
    if [ "$tries" -ge 100 ] || ! kill -0 "$listener" 2>/dev/null; then
      check "$name (the listener did not start)" FAILED
      return
    fi
    sleep 0.1
  done
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=connects_inside_root)' || inside=$?
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=connects_outside_root)' || outside=$?
  runner='' run_archive "$R/canaries.tar.zst" "$canaries" \
    -E 'test(=connects_outside_root)' || control=$?
  kill "$listener" 2>/dev/null || true
  wait "$listener" 2>/dev/null || true
  rm -f "$R.sock"
  if [ "$inside" -ne 0 ]; then
    check "a Unix socket inside the per-run root is reachable" FAILED
  else
    check "a Unix socket inside the per-run root is reachable" ok
  fi
  if [ "$control" -ne 0 ]; then
    check "$name (unconfined, the test cannot reach the listener either)" FAILED
  elif [ -z "$runner" ]; then
    check "$name" "not prevented on $os ($confinement)"
  elif [ "$outside" -ne 0 ]; then
    check "$name" ok
  else
    check "$name" FAILED
  fi
}

# --- Main ----------------------------------------------------------------------------------

case ${1-} in
  --env-probe)
    # Run by the self-check with a hostile environment: what the guard inspects, and the
    # canary that asserts the environment a test sees.
    build_scanner
    setup_confinement
    scripts/repo-guard identify "$root"
    run_archive "$2" "$canaries" -E 'test(=environment_is_clean)'
    exit
    ;;
  --self-check)
    build_scanner
    setup_confinement
    check_sweep
    self_check
    exit
    ;;
  "") ;;
  *)
    echo "usage: $0 [--self-check]" >&2
    exit 2
    ;;
esac

cargo fmt --all --check
cargo clippy --all-targets --locked -- -D warnings
# Windows-only code is linted before CI when mise installed the Windows target.
windows_target=x86_64-pc-windows-msvc
if [ "$host" != "$windows_target" ] &&
  [ -d "$(rustc --print sysroot)/lib/rustlib/$windows_target" ]; then
  cargo clippy --all-targets --locked --target "$windows_target" -- -D warnings
fi
cargo nextest archive --workspace --locked --archive-file "$R/tests.tar.zst"
build_scanner

setup_confinement
check_sweep
# The checkout's files are compared only where nothing stops a test from writing them: in CI,
# and when the tests run unconfined. Locally a confined test cannot write there, while the
# developer may edit files during the run.
checkout=
[ -n "$runner" ] || checkout=--checkout
snapshot=$R/repo.snapshot
scripts/repo-guard snapshot $checkout "$root" "$snapshot"

status=0
run_archive "$R/tests.tar.zst" "$root" || status=$?
sweep || status=1
scripts/repo-guard verify $checkout "$root" "$snapshot" || status=1
exit "$status"
