#!/bin/sh
# The completion check of every change (docs/architecture.md section 13.4): formatting,
# clippy, and the tests, run confined between a snapshot and a verify of the repository
# guard. Run it as `mise exec -- scripts/test` (on Windows, `mise exec -- sh scripts/test`).
#
#   scripts/test                 the check
#   scripts/test --self-check    show that each isolation mechanism holds: run the canaries
#                                of crates/test-support/canaries and expect each escape to
#                                fail or be caught
#
# Phase 1 (fmt, clippy, `cargo nextest archive`) builds without confinement. Phase 2 runs the
# archived tests with cargo-nextest in a constructed environment under a per-run root R
# (HOME, XDG dirs, temp dir, and git's global config inside R), each test process confined
# so that it can write only inside R: sandbox-exec on macOS, bubblewrap on Linux where it
# works; Windows gets the environment and the guard only. The tests' small volumes are an
# empty disk image under R on macOS and a tmpfs bubblewrap mounts for each test on Linux.
# Afterwards every process the run left behind, and every disk image it left attached, is
# listed, ended, and fails the run. A run's processes are those in its sandbox on macOS and
# those carrying a marker unique to the run, CARDINAL_TEST_RUN=<id>, on Linux;
# run-processes from crates/test-support finds and kills them.

# POSIX prelude: start over in a constructed environment before bash reads any startup file.
# A script run by `sh` reads no startup file, and `bash --noprofile --norc` with BASH_ENV and
# ENV unset reads none either. What passes, and why:
#   PATH                       the pinned toolchain that `mise exec` put first
#   CARGO_HOME, RUSTUP_HOME    where that toolchain and the registry live (defaulting to the
#   RUSTUP_TOOLCHAIN           locations under HOME), and which toolchain mise pinned
#   CI                         selects the guard's whole-repository mode, and reaches the
#                              tests, where it turns a skip for a missing host feature into a
#                              failure
#   CARGO_TERM_COLOR           output only
#   Windows: what programs need to start (scripts/clean-env.sh), and TEMP, TMP, USERPROFILE,
#   APPDATA, LOCALAPPDATA, ProgramData, ProgramFiles, ProgramFiles(x86), ProgramW6432 for
#   the MSVC linker lookup.
# Nothing else passes: not HOME, BASH_ENV, ENV, GIT_*, GH_*, CLAUDE_*, or CARDINAL_*.
if [ "${1-}" != --clean-env ]; then
  CARGO_HOME=${CARGO_HOME:-${HOME:-}/.cargo}
  RUSTUP_HOME=${RUSTUP_HOME:-${HOME:-}/.rustup}
  export CARGO_HOME RUSTUP_HOME
  . "$(dirname "$0")/clean-env.sh"
  linker_vars=
  case $(uname -s) in
    MINGW* | MSYS* | CYGWIN*)
      linker_vars='TEMP TMP USERPROFILE APPDATA LOCALAPPDATA ProgramData ProgramFiles ProgramFiles(x86) ProgramW6432'
      ;;
  esac
  clean_exec "PATH CARGO_HOME RUSTUP_HOME RUSTUP_TOOLCHAIN CI CARGO_TERM_COLOR $linker_vars" \
    bash --noprofile --norc "$0" --clean-env "$@"
fi
shift

set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true
export LC_ALL=C
# Passed only when set; an empty one would name no toolchain.
[ -n "${RUSTUP_TOOLCHAIN-}" ] || unset RUSTUP_TOOLCHAIN
[ -n "${CARGO_TERM_COLOR-}" ] || unset CARGO_TERM_COLOR

root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"
. scripts/clean-env.sh
os=$(uname -s)
case $os in MINGW* | MSYS* | CYGWIN*) os=Windows ;; esac

say() {
  printf 'scripts/test: %s\n' "$*" >&2
}

# The per-run root, outside any repository: `mktemp -d` in the system temp dir (TMPDIR did
# not pass). Removed on every exit, after the sweep.
R=$(cd "$(mktemp -d)" && pwd -P)
dir=$R
while [ "$dir" != / ] && [ -n "$dir" ]; do
  if [ -e "$dir/.git" ]; then
    say "the per-run root $R is inside the repository $dir"
    exit 1
  fi
  dir=$(dirname "$dir")
done
mkdir -p "$R/home/.config" "$R/home/.cache" "$R/home/.local/state" "$R/home/.local/share" \
  "$R/tmp" "$R/archive"
: >"$R/empty-gitconfig"
run_id=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
marker="CARDINAL_TEST_RUN=$run_id"
# macOS: the sandbox profile denies looking up this Mach service, which nobody registers, and
# allows `<name>.allowed`; only this run's sandbox does both.
sandbox_name=dev.cardinal.test-run.$run_id

# On every exit: the sweep, the disk images a test left attached, then R, unless an image
# under it is still attached. The self-check's listener at $R.sock exits once its socket is
# gone.
cleanup() {
  local status=$?
  if ! sweep; then
    status=1
  fi
  if ! detach_images; then
    status=1
  fi
  if [ -n "${keep_root-}" ]; then
    say "left $R in place: a disk image under it may still be attached"
    rm -f "$R.sock"
  else
    rm -rf "$R" "$R.sock"
  fi
  exit "$status"
}
trap cleanup EXIT

# Phase 1 runs with HOME inside R too, so nothing it starts reads the user's dotfiles.
export HOME=$R/home XDG_CONFIG_HOME=$R/home/.config XDG_CACHE_HOME=$R/home/.cache \
  XDG_STATE_HOME=$R/home/.local/state XDG_DATA_HOME=$R/home/.local/share \
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=$R/empty-gitconfig GIT_TERMINAL_PROMPT=0

# --- Supervisor: this run's processes ----------------------------------------------------

# run-processes, built on macOS and Linux. The self-check sets table_fault to
# --empty-table to show that a process table that lists nothing fails the sweep.
run_processes=
table_fault=

build_scanner() {
  case $os in Darwin | Linux) ;; *) return 0 ;; esac
  run_processes=$(cargo build --locked -p cardinal-test-support --bin run-processes \
    --message-format=json-render-diagnostics |
    sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -n 1)
  if [ ! -x "$run_processes" ]; then
    say "cannot build run-processes"
    exit 1
  fi
}

# run-processes list|kill for this run.
run_processes() {
  [ -n "$run_processes" ] || return 1
  # shellcheck disable=SC2086 # table_fault is empty or one word
  "$run_processes" "$1" "$sandbox_name" "$marker" $table_fault
}

# Prints the PIDs of the processes that belong to the run, and `?<pid>` for each process
# whose membership cannot be read (Linux: a process that is not dumpable hides its
# environment even from its owner); fails when the process table cannot be read, and returns
# 2 on Windows, which has no sweep.
scan() {
  case $os in
    Darwin | Linux) run_processes list || return 1 ;;
    *) return 2 ;;
  esac
}

# Process <pid> for a message: its group and command line, and its parent's PID and command
# line, which lead to the test that started it (a parent that is init or a subreaper means
# the process was orphaned).
describe() {
  local line pid ppid pgid args parent
  if ! line=$(ps -o pid= -o ppid= -o pgid= -o args= -p "$1" 2>/dev/null); then
    printf '%s (exited)' "$1"
    return
  fi
  read -r pid ppid pgid args <<<"$line"
  parent=$(ps -o args= -p "$ppid" 2>/dev/null) || parent='(exited)'
  printf '%s in group %s: %s; parent %s: %s' "$pid" "$pgid" "$args" "$ppid" "$parent"
}

# The PIDs that belong to the run.
marked_pids() {
  local found
  found=$(scan) || return
  printf '%s\n' "$found" | grep -v '^?' || true
}

# Kills and lists every process this run left behind; fails if there was one, if the
# process table cannot be read, or if a process whose membership cannot be read appeared
# since check_sweep (it may be a test process). Each PID found is in this run's sandbox or
# carries its marker, so it is one this run started; run-processes signals a PID only while
# it still names that process. Nothing to do before the first test process starts.
started=0
swept=0
sweep() {
  [ "$started" -eq 1 ] || return 0
  local found pids hidden status=0 failed=0
  found=$(scan) || status=$?
  if [ "$status" -eq 2 ]; then
    return 0
  elif [ "$status" -ne 0 ]; then
    say "cannot read the process table to find leftover test processes"
    return 1
  fi
  pids=$(printf '%s\n' "$found" | grep -v '^?' || true)
  hidden=$(printf '%s\n' "$found" | sed -n 's/^?//p' | sort)
  for pid in $(printf '%s\n' "$hidden" | comm -13 "$R/hidden" - 2>/dev/null); do
    say "cannot tell whether process $(describe "$pid") belongs to the run; it started during the run"
    failed=1
  done
  [ -n "$pids" ] || return "$failed"
  for pid in $pids; do
    say "leftover test process $(describe "$pid")"
    swept=$((swept + 1))
  done
  status=0
  run_processes kill >/dev/null || status=$?
  case $status in
    0) ;;
    3) say "leftover test processes survived SIGKILL" ;;
    *) say "cannot read the process table to kill leftover test processes" ;;
  esac
  return 1
}

# Starts a process the way a test process starts, confined and with the marker, and checks
# that the sweep sees it, so a sweep that finds nothing means nothing was left; then checks
# that nothing of it outlives its kill, so a leftover found later is a test's.
#
# The probe reports its PID from inside the runner, and the check waits for that process,
# not the runner: bubblewrap forks the command and sets it to die with bubblewrap only right
# before the exec, so killing bubblewrap during its setup would orphan the command. Once the
# probe has reported, run-processes kills it and the runner, which carry the run's sandbox or
# marker; a probe the sweep cannot see is not signalled and ends by itself.
check_sweep() {
  started=1
  [ "$os" != Windows ] || {
    say "Windows: no process sweep; leftovers are found only by nextest's leak check"
    return 0
  }
  local found
  if ! found=$(scan); then
    say "cannot read the process table"
    return 1
  fi
  # Processes whose membership is already hidden are not this run's.
  printf '%s\n' "$found" | sed -n 's/^?//p' | sort >"$R/hidden"
  local ready=$R/probe.pid
  # shellcheck disable=SC2016,SC2086 # $$ and $1 are the probe's; the runner has no spaces
  env -i PATH="$PATH" "$marker" $runner \
    sh -c 'echo "$$" >"$1.tmp" && mv "$1.tmp" "$1" && exec sleep 30' sh "$ready" </dev/null &
  local probe=$! pid='' pids='' seen=0 unreadable=0 tries=0
  while [ "$tries" -lt 50 ]; do
    [ -n "$pid" ] || pid=$(cat "$ready" 2>/dev/null) || pid=''
    if [ -n "$pid" ]; then
      pids=$(marked_pids) || {
        unreadable=1
        break
      }
      case " $(printf '%s ' $pids)" in
        *" $pid "*)
          seen=1
          break
          ;;
      esac
    fi
    tries=$((tries + 1))
    sleep 0.1
  done
  if [ "$seen" -eq 1 ]; then
    local status=0
    run_processes kill >/dev/null || status=$?
    # 3: something survived, which the check below reports.
    [ "$status" -eq 0 ] || [ "$status" -eq 3 ] || unreadable=1
  fi
  wait "$probe" 2>/dev/null || true
  if [ "$unreadable" -eq 1 ]; then
    say "cannot read the process table"
    return 1
  elif [ "$seen" -eq 0 ]; then
    say "the process sweep cannot see its probe process ${pid:-(it did not start)}"
    return 1
  fi
  tries=0
  while :; do
    pids=$(marked_pids) || {
      say "cannot read the process table"
      return 1
    }
    [ -n "$pids" ] || return 0
    tries=$((tries + 1))
    [ "$tries" -lt 20 ] || break
    sleep 0.1
  done
  for pid in $pids; do
    say "the process sweep's probe left process $(describe "$pid")"
  done
  return 1
}

# --- Confinement -------------------------------------------------------------------------

# Sets `runner` to the command that confines one test process, or empty, `confinement` to a
# description, and on Linux under bubblewrap `volume` to the path of each test process's
# tmpfs.
runner=
confinement=
volume=
setup_confinement() {
  case $R in *' '*)
    # A target runner is split at spaces.
    if [ "$os" = Darwin ]; then
      say "cannot confine the tests: the per-run root $R has a space"
      exit 1
    fi
    confinement="UNCONFINED: the per-run root $R has a space, which a target runner cannot carry"
    say "$confinement"
    return
    ;;
  esac
  case $os in
    Darwin)
      cat >"$R/sandbox.sb" <<EOF
(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath "$R")
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (regex #"^/dev/fd/[0-9]+\$")
  (regex #"^/dev/ttys[0-9]+\$"))
(deny network*)
(allow network* (local unix-socket (subpath "$R")))
(allow network* (remote unix-socket (subpath "$R")))
(deny mach-lookup (global-name "$sandbox_name.denied"))
EOF
      runner="sandbox-exec -f $R/sandbox.sb"
      confinement="sandbox-exec: writes only under the per-run root, no network"
      ;;
    Linux)
      # A fresh /dev: on the read-only bind of the host's, /dev/null cannot be opened for
      # writing, which every child with null stdio needs. Empty file systems over the places
      # that hold the host's Unix sockets (agents, the session bus, container daemons) and
      # shared memory, so a test cannot reach them; then the checkout, read-only, where one
      # of them hid it (a test's working directory and the files it reads are there; the
      # test binaries run from the archive, extracted under R); then R, which lies under /tmp;
      # then a 64 MiB tmpfs at R/volume, a small volume of each test process's own
      # (`Scope::tmpfs`, docs/architecture.md section 13.3): bubblewrap mounts it in its own
      # user namespace, whose ID map lets the test create files there.
      local bwrap=(bwrap --ro-bind / / --dev /dev) mask masks=()
      for mask in /tmp /var/tmp /run /var/run /dev/shm; do
        if [ "$mask" = /dev/shm ] || { [ -d "$mask" ] && [ ! -L "$mask" ]; }; then
          bwrap+=(--tmpfs "$mask")
          masks+=("$mask")
        fi
      done
      for mask in "${masks[@]}"; do
        case $root/ in
          "$mask"/*)
            case $root in *' '*)
              confinement="UNCONFINED: the checkout $root has a space, which a target runner cannot carry"
              say "$confinement"
              return
              ;;
            esac
            bwrap+=(--ro-bind "$root" "$root")
            break
            ;;
        esac
      done
      bwrap+=(--bind "$R" "$R")
      local tail=(--unshare-net --die-with-parent --) error
      local sized=(--size $((64 << 20)) --tmpfs "$R/volume")
      if ! error=$("${bwrap[@]}" "${tail[@]}" sh -c ': >/dev/null && : >"$1/probe"' sh "$R" 2>&1)
      then
        confinement="UNCONFINED: bubblewrap does not work here (${error:-not installed}); writes outside the per-run root are found only by the repository guard, and those to other branches, remote-tracking refs, the objects, or other refs only in CI"
      elif ! "${bwrap[@]}" "${tail[@]}" test -r "$root/Cargo.toml"; then
        say "bubblewrap hides the checkout $root from the tests"
        exit 1
      else
        confinement="bubblewrap: writes only under the per-run root, no network, host sockets masked"
        # Probed apart, so a bubblewrap without `--size` still confines the tests; the tests
        # that need the volume then fail in CI and are skipped elsewhere.
        mkdir "$R/volume"
        if error=$("${bwrap[@]}" "${sized[@]}" "${tail[@]}" sh -c ': >"$1/volume/probe"' sh \
          "$R" 2>&1); then
          bwrap+=("${sized[@]}")
          volume=$R/volume
        else
          confinement="$confinement; no tmpfs volume, bubblewrap cannot mount a size-limited tmpfs (${error:-no message})"
        fi
        runner="${bwrap[*]} ${tail[*]}"
      fi
      ;;
    *)
      confinement="UNCONFINED on $os: constructed environment and the repository guard only"
      ;;
  esac
  say "$confinement"
}

# --- Disk image (macOS) -------------------------------------------------------------------

# The empty APFS image `Scope::attach_image` clones for a small volume that fills up
# (docs/architecture.md section 13.3), made before the tests start: inside their sandbox
# `hdiutil create` fails, while `hdiutil attach` of an existing image works. Without it the
# tests that need one are skipped, or fail where CI is true.
image=
make_image() {
  [ "$os" = Darwin ] || return 0
  mkdir "$R/image"
  if hdiutil create -quiet -size 256m -fs APFS -volname cardinal-test -layout NONE \
    "$R/image/empty.dmg"; then
    image=$R/image/empty.dmg
  else
    say "no disk image: hdiutil create failed; the tests that need one are skipped"
  fi
}

# The whole device of each attached disk image whose file is under R.
attached_images() {
  hdiutil info | awk -v r="$R/" '
    /^image-path/ { sub(/^image-path[ \t]*:[ \t]*/, ""); keep = index($0, r) == 1; next }
    keep && /^\/dev\/disk[0-9]+[ \t]/ { print $1; keep = 0 }'
}

# The image's guard detaches each clone, from outside the sandbox, so the sweep cannot end a
# clone a killed test left attached: it is detached here, listing again after each try, up to
# three tries, and fails the run. While one stays attached, or the list cannot be read,
# `keep_root` keeps R from being removed through the mounted volume.
keep_root=
detach_images() {
  [ -n "${image-}" ] || return 0
  local devices device tries=0 found=0
  while devices=$(attached_images); do
    [ -n "$devices" ] || return "$found"
    found=1
    if [ "$tries" -ge 3 ]; then
      say "disk images still attached after $tries tries:" $devices
      keep_root=1
      return 1
    fi
    tries=$((tries + 1))
    for device in $devices; do
      say "a test left the disk image $device attached; detaching it"
      hdiutil detach -force -quiet "$device" || true
    done
    sleep 1
  done
  say "cannot list the attached disk images"
  keep_root=1
  return 1
}

# --- Phase 2 -----------------------------------------------------------------------------

host=$(rustc -vV | sed -n 's/^host: //p')
runner_var=CARGO_TARGET_$(printf '%s' "$host" | tr 'a-z-' 'A-Z_')_RUNNER

# run_archive <archive> <workspace> [nextest args...]: the archived tests in the constructed
# environment, each test process confined. `nextest list` extracts the archive; each binary
# under test then starts once (`--version`), so its first start, which macOS checks for seconds
# on a loaded host (XProtect, docs/architecture.md section 13.3), is behind every test; the
# tests run from the extracted tree. Returns nextest's status.
run_archive() {
  local archive=$1 workspace=$2
  shift 2
  started=1
  local extract
  extract=$(mktemp -d "$R/archive/XXXXXX")
  local env=(
    PATH="$PATH"
    HOME="$R/home"
    XDG_CONFIG_HOME="$R/home/.config"
    XDG_CACHE_HOME="$R/home/.cache"
    XDG_STATE_HOME="$R/home/.local/state"
    XDG_DATA_HOME="$R/home/.local/share"
    GIT_CONFIG_NOSYSTEM=1
    GIT_CONFIG_GLOBAL="$R/empty-gitconfig"
    GIT_CEILING_DIRECTORIES="$(dirname "$R")"
    GIT_TERMINAL_PROMPT=0
    LC_ALL=C
    PROPTEST_DISABLE_FAILURE_PERSISTENCE=1
    "$marker"
  )
  if [ "$os" = Windows ]; then
    env+=(TEMP="$R/tmp" TMP="$R/tmp" USERPROFILE="$R/home" APPDATA="$R/home/AppData/Roaming"
      LOCALAPPDATA="$R/home/AppData/Local")
  else
    env+=(TMPDIR="$R/tmp")
  fi
  [ -z "${CARGO_TERM_COLOR-}" ] || env+=(CARGO_TERM_COLOR="$CARGO_TERM_COLOR")
  [ -z "${CI-}" ] || env+=(CI="$CI")
  [ -z "$image" ] || env+=(CARDINAL_TEST_IMAGE="$image")
  [ -z "$volume" ] || env+=(CARDINAL_TEST_TMPFS="$volume")
  [ -z "$runner" ] || env+=("$runner_var=$runner")
  local nextest=(clean_exec '' "${env[@]}" cargo-nextest nextest)
  ("${nextest[@]}" list --archive-file "$archive" --workspace-remap "$workspace" \
    --extract-to "$extract" --config-file "$root/.config/nextest.toml" >/dev/null) || return
  local meta=$extract/target/nextest bin
  for bin in $(awk '/"kind": "bin-exe"/ { found = 1; next }
      found && /"path":/ { sub(/^[^:]*: *"/, ""); sub(/",?[ \t\r]*$/, ""); print; found = 0 }' \
    "$meta/binaries-metadata.json"); do
    # shellcheck disable=SC2086 # the runner is split at spaces, as nextest splits it
    (clean_exec '' "${env[@]}" $runner "$extract/target/$bin" --version) >/dev/null 2>&1 || true
  done
  ("${nextest[@]}" run --binaries-metadata "$meta/binaries-metadata.json" \
    --cargo-metadata "$meta/cargo-metadata.json" --target-dir-remap "$extract/target" \
    --workspace-remap "$workspace" --config-file "$root/.config/nextest.toml" "$@")
}

# --- Self-check ----------------------------------------------------------------------------

canaries=$root/crates/test-support/canaries
canary_target=$root/target/canaries

self_check() {
  local failed=0 out status
  check() {
    say "self-check: $1: $2"
    [ "$2" != FAILED ] || failed=1
  }
  CARGO_TARGET_DIR=$canary_target cargo nextest archive --locked \
    --manifest-path "$canaries/Cargo.toml" --archive-file "$R/canaries.tar.zst"

  # Each way to build a spawnable command outside the spawn API fails the lint.
  local example
  for example in raw_spawn cargo_ext_spawn; do
    if out=$(CARGO_TARGET_DIR=$canary_target cargo clippy --locked \
      --manifest-path "$canaries/Cargo.toml" --example "$example" -- -D warnings 2>&1); then
      check "$example fails the lint" FAILED
    elif printf '%s' "$out" | grep -q 'disallowed_methods\|disallowed method'; then
      check "$example fails the lint" ok
    else
      printf '%s\n' "$out" >&2
      check "$example fails the lint" FAILED
    fi
  done

  # A write outside R fails, and nothing is written.
  local escape=$root/target/canary-escape
  rm -f "$escape"
  status=0
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=writes_outside_root)' || status=$?
  if [ -n "$runner" ]; then
    if [ "$status" -ne 0 ] && [ ! -e "$escape" ]; then
      check "a write outside the per-run root fails" ok
    else
      check "a write outside the per-run root fails" FAILED
    fi
  else
    check "a write outside the per-run root fails" "not prevented on $os ($confinement)"
  fi
  rm -f "$escape"

  # A Unix socket outside R, at $R.sock where a listener started before the tests accepts
  # connections, cannot be reached; one inside R can. Without confinement the same test
  # reaches it, which shows the listener works.
  if [ "$os" != Windows ]; then
    socket_check
  else
    check "a Unix socket outside the per-run root is unreachable" "not checked on Windows"
  fi

  # Leftover processes are killed and fail the run: one with its output closed, one in a
  # session of its own, one that closed every descriptor, and a daemon (forked twice, in a
  # new session, every descriptor closed).
  if [ "$os" != Windows ]; then
    run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(~leaves_)' || true
    swept=0
    if sweep; then
      check "leftover processes are killed and fail the run" FAILED
    elif [ "$swept" -ge 4 ] && [ -z "$(marked_pids)" ]; then
      check "leftover processes are killed and fail the run" ok
    else
      check "leftover processes are killed and fail the run (swept $swept of 4)" FAILED
    fi
  else
    check "leftover processes are killed and fail the run" "not checked on Windows"
  fi

  # A process table that lists nothing (proc_listallpids returns 0 when it fails) fails the
  # sweep instead of reading as empty: the scanner itself is always in it.
  if [ "$os" != Windows ]; then
    if (table_fault=--empty-table sweep) 2>"$R/sweep.err"; then
      check "an empty process table fails the run" FAILED
    elif grep -q 'cannot read the process table' "$R/sweep.err"; then
      check "an empty process table fails the run" ok
    else
      cat "$R/sweep.err" >&2
      check "an empty process table fails the run" FAILED
    fi
  else
    check "an empty process table fails the run" "not checked on Windows"
  fi

  # Started with BASH_ENV, ENV, and GIT_* pointing at a decoy, no test sees them, no startup
  # file runs, the guard inspects this checkout, and the decoy is untouched.
  local decoy=$R/decoy
  git init -q -b main "$decoy"
  git -C "$decoy" -c user.name=decoy -c user.email=decoy@invalid commit -q --allow-empty -m decoy
  scripts/repo-guard snapshot "$decoy" "$R/decoy.snapshot"
  printf 'echo ran >%s\n' "$R/startup-ran" >"$R/startup"
  status=0
  out=$(BASH_ENV=$R/startup ENV=$R/startup GIT_DIR=$decoy/.git GIT_WORK_TREE=$decoy \
    GIT_INDEX_FILE=$decoy/.git/index sh "$root/scripts/test" --env-probe "$R/canaries.tar.zst" \
    2>&1) || status=$?
  printf '%s\n' "$out" | sed 's/^/  /' >&2
  if [ "$status" -eq 0 ] && [ ! -e "$R/startup-ran" ] &&
    printf '%s\n' "$out" | grep -qxF "top $root" &&
    scripts/repo-guard verify "$decoy" "$R/decoy.snapshot"; then
    check "inherited BASH_ENV, ENV, and GIT_* reach nothing" ok
  else
    check "inherited BASH_ENV, ENV, and GIT_* reach nothing" FAILED
  fi
  return "$failed"
}

# The socket part of the self-check: a listener (the canaries' `listen` example) at $R.sock.
# It is never signalled: it exits once the socket is removed, here or by cleanup, once this
# script is gone, or after two minutes.
socket_check() {
  local name="a Unix socket outside the per-run root is unreachable"
  CARGO_TARGET_DIR=$canary_target cargo build --locked --quiet \
    --manifest-path "$canaries/Cargo.toml" --example listen
  "$canary_target/debug/examples/listen" "$R.sock" 120 &
  local listener=$! tries=0 inside=0 outside=0 control=0
  while [ ! -S "$R.sock" ]; do
    tries=$((tries + 1))
    if [ "$tries" -ge 100 ]; then
      check "$name (the listener did not start)" FAILED
      return
    fi
    sleep 0.1
  done
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=connects_inside_root)' || inside=$?
  run_archive "$R/canaries.tar.zst" "$canaries" -E 'test(=connects_outside_root)' || outside=$?
  runner='' run_archive "$R/canaries.tar.zst" "$canaries" \
    -E 'test(=connects_outside_root)' || control=$?
  rm -f "$R.sock"
  wait "$listener" 2>/dev/null || true
  if [ "$inside" -ne 0 ]; then
    check "a Unix socket inside the per-run root is reachable" FAILED
  else
    check "a Unix socket inside the per-run root is reachable" ok
  fi
  if [ "$control" -ne 0 ]; then
    check "$name (unconfined, the test cannot reach the listener either)" FAILED
  elif [ -z "$runner" ]; then
    check "$name" "not prevented on $os ($confinement)"
  elif [ "$outside" -ne 0 ]; then
    check "$name" ok
  else
    check "$name" FAILED
  fi
}

# --- Main ----------------------------------------------------------------------------------

case ${1-} in
  --env-probe)
    # Run by the self-check with a hostile environment: what the guard inspects, and the
    # canary that asserts the environment a test sees.
    build_scanner
    setup_confinement
    scripts/repo-guard identify "$root"
    run_archive "$2" "$canaries" -E 'test(=environment_is_clean)'
    exit
    ;;
  --self-check)
    build_scanner
    setup_confinement
    check_sweep
    self_check
    exit
    ;;
  "") ;;
  *)
    echo "usage: $0 [--self-check]" >&2
    exit 2
    ;;
esac

cargo fmt --all --check
cargo clippy --all-targets --locked -- -D warnings
# Windows-only code is linted before CI when mise installed the Windows target.
windows_target=x86_64-pc-windows-msvc
if [ "$host" != "$windows_target" ] &&
  [ -d "$(rustc --print sysroot)/lib/rustlib/$windows_target" ]; then
  cargo clippy --all-targets --locked --target "$windows_target" -- -D warnings
fi
cargo nextest archive --workspace --locked --archive-file "$R/tests.tar.zst"
build_scanner

setup_confinement
check_sweep
make_image
# The checkout's files are compared only where nothing stops a test from writing them: in CI,
# and when the tests run unconfined. Locally a confined test cannot write there, while the
# developer may edit files during the run.
checkout=
[ -n "$runner" ] || checkout=--checkout
snapshot=$R/repo.snapshot
scripts/repo-guard snapshot $checkout "$root" "$snapshot"

status=0
run_archive "$R/tests.tar.zst" "$root" || status=$?
sweep || status=1
scripts/repo-guard verify $checkout "$root" "$snapshot" || status=1
exit "$status"
